<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Agar file ya folder exist karta hai, toh use waise hi serve karo
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l

  # SABSE ZAROORI LINE: /category/ AUR /blog/ dono ko exclude karo
  RewriteCond %{REQUEST_URI} !^/(category|blog)/

  # Baaki sab kuch (tumhara React app) index.html par jayega
  RewriteRule . /index.html [L]
</IfModule>